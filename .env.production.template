# BBQ Knives Production Environment Template
# Copy this file to .env on the droplet and fill in the values

# ===================
# DATABASE
# ===================
POSTGRES_DB=medusa-bbq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_USE_SECURE_PASSWORD

# ===================
# BACKEND (Medusa)
# ===================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_STRING
COOKIE_SECRET=CHANGE_ME_GENERATE_ANOTHER_RANDOM_STRING

# CORS settings - update with your domain
STORE_CORS=http://209.38.205.122:8000
ADMIN_CORS=http://209.38.205.122:9000
AUTH_CORS=http://209.38.205.122:9000

# ===================
# STOREFRONT (Next.js)
# ===================
# Get this from Medusa Admin > Settings > API Key Management
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_YOUR_PUBLISHABLE_KEY_HERE
NEXT_PUBLIC_BASE_URL=http://209.38.205.122:8000
NEXT_PUBLIC_DEFAULT_REGION=de
MEDUSA_BACKEND_URL=http://backend:9000

# ===================
# STRIPE (Optional)
# ===================
STRIPE_API_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_KEY=pk_live_xxx

# ===================
# PAYPAL (Optional)
# ===================
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# ===================
# EMAIL - RESEND (Optional)
# ===================
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
